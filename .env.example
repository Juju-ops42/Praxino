# Praxino — Beispiel-Umgebungsvariablen
# Kopiere diese Datei zu .env.local und fülle die Werte aus.

# --- Supabase (Frontend, public anon) ---
# Aus dem Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (Backend / Server-only) ---
# WICHTIG: Niemals im Frontend einsetzen. Nur in Edge Functions / Server Code.
SUPABASE_SERVICE_ROLE_KEY=

